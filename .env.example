# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Required: Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Required: Discord Application ID (Client ID)
CLIENT_ID=your_application_id_here

# Required: Discord Client Secret (for OAuth2 if needed)
CLIENT_SECRET=your_client_secret_here

# Required: Database URL (PostgreSQL)
# For local development: postgresql://bot:password@localhost:5432/discord_bot
# For Docker: postgresql://bot:${DB_PASSWORD}@db:5432/discord_bot
DATABASE_URL=postgresql://bot:password@localhost:5432/discord_bot

# Required: Database Password (for Docker Compose)
DB_PASSWORD=secure_random_password_here

# Optional: Comma-separated list of Owner User IDs (for owner-only commands)
OWNER_IDS=123456789012345678,987654321098765432

# Optional: Bot Prefix (default: !)
BOT_PREFIX=!

# Optional: Log Level (debug, info, warn, error) - default: info
LOG_LEVEL=info

# Optional: Node Environment
NODE_ENV=development