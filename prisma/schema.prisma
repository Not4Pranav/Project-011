// Prisma Schema for Discord Bot
// Run `npx prisma generate` after changes
// Run `npx prisma db push` to sync with database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core models
model GuildConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique
  prefix          String   @default("!")
  language        String   @default("en")
  logChannelId    String?
  modLogChannelId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  ticketConfig    TicketConfig?
  welcomeConfig   WelcomeConfig?
  modConfig       ModConfig?
  gameConfig      GameConfig?
  voicemasterConfig VoicemasterConfig?
  starboardConfig StarboardConfig?
  automodConfig   AutomodConfig?
  antinukeConfig  AntinukeConfig?
  reactionRoleConfig ReactionRoleConfig?
  permissions     PermissionRole[]
  snipedMessages  SnipedMessage[]
  quotes          Quote[]
}

model PermissionRole {
  id        String   @id @default(cuid())
  guildId   String
  roleId    String
  level     Int      // 1=mod, 2=admin, 3=owner
  guildConfig GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  @@unique([guildId, roleId])
}

// Ticket System
model TicketConfig {
  id                  String   @id @default(cuid())
  guildId             String   @unique
  categoryId          String?
  logChannelId        String?
  supportRoleId       String?
  transcriptChannelId String?
  guildConfig         GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  panels              TicketPanel[]
  tickets             Ticket[]
}

model TicketPanel {
  id          String   @id @default(cuid())
  configId    String
  channelId   String
  messageId   String
  title       String
  description String
  emoji       String
  categoryId  String?
  config      TicketConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String   @id @default(cuid())
  configId    String
  channelId   String   @unique
  userId      String
  claimedBy   String?
  status      TicketStatus @default(OPEN)
  type        String?
  createdAt   DateTime @default(now())
  closedAt    DateTime?
  config      TicketConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  messages    TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  content   String
  attachments String[] @default([])
  createdAt DateTime @default(now())
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

enum TicketStatus {
  OPEN
  CLAIMED
  CLOSED
  DELETED
}

// Welcome System
model WelcomeConfig {
  id             String   @id @default(cuid())
  guildId        String   @unique
  enabled        Boolean  @default(true)
  channelId      String?
  dmEnabled      Boolean  @default(false)
  dmMessage      String?
  roleId         String?
  leaveChannelId String?
  leaveMessage   String?
  inviteTracking Boolean  @default(true)
  fakeUserCheck  Boolean  @default(true)
  guildConfig    GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  messages       WelcomeMessage[]
}

model WelcomeMessage {
  id        String   @id @default(cuid())
  configId  String
  type      WelcomeType
  content   String
  embedData Json?
  config    WelcomeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}

enum WelcomeType {
  WELCOME
  LEAVE
  DM
}

// Moderation
model ModConfig {
  id            String   @id @default(cuid())
  guildId       String   @unique
  logChannelId  String?
  dmOnAction    Boolean  @default(true)
  muteRoleId    String?
  guildConfig   GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  warnings      Warning[]
  mutes         Mute[]
  cases         ModCase[]
  appeals       Appeal[]
}

model Warning {
  id        String   @id @default(cuid())
  configId  String
  userId    String
  moderatorId String
  reason    String
  createdAt DateTime @default(now())
  config    ModConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}

model Mute {
  id        String   @id @default(cuid())
  configId  String
  userId    String
  moderatorId String
  reason    String
  duration  Int?     // minutes, null = permanent
  expiresAt DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  config    ModConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}

model ModCase {
  id          String   @id @default(cuid())
  configId    String
  type        CaseType
  userId      String
  moderatorId String
  reason      String
  duration    Int?
  createdAt   DateTime @default(now())
  config      ModConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}

enum CaseType {
  WARN
  MUTE
  UNMUTE
  KICK
  BAN
  UNBAN
  TIMEOUT
  PURGE
}

// Games
model GameConfig {
  id            String   @id @default(cuid())
  guildId       String   @unique
  economyEnabled Boolean  @default(true)
  guildConfig   GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  users         GameUser[]
  leaderboards  Leaderboard[]
  giveaways     Giveaway[]
}

model GameUser {
  id        String   @id @default(cuid())
  configId  String
  userId    String
  balance   Int      @default(1000)
  xp        Int      @default(0)
  level     Int      @default(1)
  streak    Int      @default(0)
  lastDaily DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  config    GameConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  @@unique([configId, userId])
}

model Leaderboard {
  id        String   @id @default(cuid())
  configId  String
  type      LeaderboardType
  userId    String
  value     Int
  config    GameConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  @@unique([configId, type, userId])
}

enum LeaderboardType {
  BALANCE
  XP
  WINS
  GAMES_PLAYED
}

// Utility
model SnipedMessage {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  userId    String
  content   String
  attachments String[] @default([])
  embeds    Json?
  deletedAt DateTime @default(now())
  guildConfig GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model Quote {
  id        String   @id @default(cuid())
  guildId   String
  messageId String   @unique
  userId    String
  content   String
  createdAt DateTime @default(now())
  guildConfig GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model Appeal {
  id        String   @id @default(cuid())
  configId  String
  caseId    String
  userId    String
  reason    String
  status    AppealStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  config     ModConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  @@unique([configId, caseId, userId])
}

model VoicemasterConfig {
  id            String   @id @default(cuid())
  guildId       String   @unique
  enabled       Boolean  @default(false)
  categoryId    String?
  createChannelId String?
  ownerId       String?
  maxChannels   Int      @default(0)
  defaultLimit  Int      @default(0)
  defaultName   String?  @default("{user}'s channel")
  bitrate       Int      @default(64)
  guildConfig   GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  tempChannels  TempVoiceChannel[]
}

model TempVoiceChannel {
  id        String   @id @default(cuid())
  configId  String
  channelId String   @unique
  ownerId   String
  name      String?
  createdAt DateTime @default(now())
  config    VoicemasterConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}

enum AppealStatus {
  PENDING
  APPROVED
  DENIED
}

model Giveaway {
  id           String   @id @default(cuid())
  configId     String
  messageId    String   @unique
  channelId    String
  prize        String
  winners      Int      @default(1)
  endsAt       DateTime
  description  String?
  participants String[] @default([])
  ended        Boolean  @default(false)
  winnerIds    String?
  createdAt    DateTime @default(now())
  config       GameConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}
model StarboardConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  enabled   Boolean  @default(false)
  channelId String?
  threshold Int      @default(5)
  emoji     String   @default("⭐")
  selfStar  Boolean  @default(false)
  guildConfig GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  entries   StarboardEntry[]
}

model StarboardEntry {
  id        String   @id @default(cuid())
  configId  String
  messageId String   @unique
  channelId String
  starCount Int      @default(0)
  starMessageId String?
  createdAt DateTime @default(now())
  config    StarboardConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}


model AutomodConfig {
  id            String   @id @default(cuid())
  guildId       String   @unique
  enabled       Boolean  @default(false)
  logChannelId  String?
  dmOnAction    Boolean  @default(true)
  guildConfig   GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  rules         AutomodRule[]
}

model AutomodRule {
  id              String   @id @default(cuid())
  configId        String
  name            String
  type            String
  triggers        String[]
  action          String
  timeoutDuration Int?
  exemptRoles     String[] @default([])
  exemptChannels  String[] @default([])
  ignoreBots      Boolean  @default(true)
  ignoreWebhooks  Boolean  @default(true)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  config          AutomodConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}


model AntinukeConfig {
  id            String   @id @default(cuid())
  guildId       String   @unique
  enabled       Boolean  @default(false)
  logChannelId  String?
  punishment    String   @default("BAN")
  timeout       Int      @default(10)
  guildConfig   GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  logs          AntinukeLog[]
  whitelist     AntinukeWhitelist[]
}

model AntinukeLog {
  id           String   @id @default(cuid())
  configId     String
  actionType   String
  executorId   String
  targetId     String
  punished     Boolean  @default(false)
  createdAt    DateTime @default(now())
  config       AntinukeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}

model AntinukeWhitelist {
  id        String   @id @default(cuid())
  configId  String
  targetId  String
  type      String
  createdAt DateTime @default(now())
  config    AntinukeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  @@unique([configId, targetId, type])
}


model ReactionRoleConfig {
  id            String   @id @default(cuid())
  guildId       String   @unique
  enabled       Boolean  @default(false)
  guildConfig   GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  messages      ReactionRoleMessage[]
}

model ReactionRoleMessage {
  id          String   @id @default(cuid())
  configId    String
  messageId   String   @unique
  channelId   String
  type        String
  mode        String
  title       String
  description String
  config      ReactionRoleConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  roles       ReactionRole[]
}

model ReactionRole {
  id          String   @id @default(cuid())
  messageId   String
  roleId      String
  label       String
  emoji       String?
  description String?
  createdAt   DateTime @default(now())
  message     ReactionRoleMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@unique([messageId, roleId])
}

